# ==========================================
# VIKM GROUP Environment Variables Example
# ==========================================

# 1. Supabase Database & Quotation Storage
# Get your project URL and Anon Key at https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Groq AI API ("Gilbert" AI Assistant Chatbot)
# Get your free fast API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 3. Brevo Transactional Email API (Admin Invitations)
# Get your free API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=sandrinetech97@gmail.com
BREVO_SENDER_NAME=VIKM GROUP Ltd
